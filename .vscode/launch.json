    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${fileDirname}",
            "console": "integratedTerminal",
            "dlvFlags": ["--check-go-version=false"],
            "env": {
                "SOPS_AGE_KEY_FILE": "/home/chouette/.config/age/key2.txt",
                // "SR_WEBGL_MODE": "hardware",
                // "SR_WEBGL_MODE": "swiftshader",
                "SR_HEADLESS": "0",
                "SR_ADREWARD_NO_PROGRESS_WAIT_SEC": "50",
                "SR_ADREWARD_DEBUG_HTML": "1",
                "SR_BROWSER_BIN": "/etc/profiles/per-user/chouette/bin/google-chrome-stable",
            },
            "args": [
                // "daily",
                // "newcommer",
                // "10", // No of Rooms
                // "40", // Viewing Time
                // "39", // Comment
                "viewreward", // Event ID
                "1",
                "1",
                "nil",
            ]
        }
    ]
}
